<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.daytrader.harness</string>
    
    <key>ProgramArguments</key>
    <array>
        <!-- Adjust paths to your installation -->
        <string>/Users/trader/day-trader/.venv/bin/python</string>
        <string>-m</string>
        <string>trader.cli</string>
        <string>run</string>
    </array>
    
    <key>WorkingDirectory</key>
    <string>/Users/trader/day-trader</string>
    
    <key>EnvironmentVariables</key>
    <dict>
        <!-- Source .env manually or set vars here -->
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    
    <key>StandardOutPath</key>
    <string>/Users/trader/day-trader/logs/trader.jsonl</string>
    
    <key>StandardErrorPath</key>
    <string>/Users/trader/day-trader/logs/trader.jsonl</string>
    
    <!-- Restart policy -->
    <key>KeepAlive</key>
    <true/>
    
    <key>RunAtLoad</key>
    <true/>
    
    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>
