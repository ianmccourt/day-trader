[Unit]
Description=day-trader paper trading harness
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Run as your user (replace with actual username)
User=trader
Group=trader

# Working directory (adjust to your installation)
WorkingDirectory=/home/trader/day-trader

# Environment file with secrets (never commit this)
EnvironmentFile=/home/trader/day-trader/.env

# Command to run
ExecStart=/home/trader/day-trader/.venv/bin/python -m trader.cli run

# Restart policy
Restart=always
RestartSec=10s

# Logging
StandardOutput=append:/home/trader/day-trader/logs/trader.jsonl
StandardError=append:/home/trader/day-trader/logs/trader.jsonl

# Resource limits (optional)
# MemoryMax=2G
# CPUQuota=200%

[Install]
WantedBy=multi-user.target
