# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Alpaca PAPER trading credentials only. Generate them at
# https://app.alpaca.markets/paper/dashboard/overview -> "Generate New Key".
# Live-trading keys will not work: the base URL is hard-coded to the paper
# endpoint (see src/trader/constants.py) and there is no way to change it.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Anthropic API key (Phase 3 onward; unused by the Phase 1 stub agent).
ANTHROPIC_API_KEY=

# Optional overrides
TRADER_DB_PATH=data/trader.sqlite3
TRADER_CYCLE_MINUTES=5
TRADER_LOG_LEVEL=INFO

# Broker adapter. `paper` (default) is Alpaca paper. `robinhood_agentic` sends
# approved orders to the Robinhood Agentic MCP account through the same risk
# layer. This is not an Alpaca live-URL switch — that endpoint does not exist
# in this repo. Tokens come from `uv run trader rh-login`.
# TRADER_BROKER=paper
# TRADER_ROBINHOOD_TOKEN_PATH=data/robinhood_tokens.json
